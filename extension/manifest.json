{
  "manifest_version": 3,
  "name": "Chrupio Companion",
  "description": "Tells the Chrupio macOS app when you are in a Google Meet, Microsoft Teams, Slack huddle or Zoom web call, and who is in it.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Chrupio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["alarms", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:47811/*",
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://teams.cloud.microsoft/*",
    "https://app.slack.com/*",
    "https://*.zoom.us/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content/common.js", "content/meet.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*"
      ],
      "js": ["content/common.js", "content/teams.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://app.slack.com/*"],
      "js": ["content/common.js", "content/slack.js"],
      "run_at": "document_idle",
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["https://*.zoom.us/wc/*"],
      "js": ["content/common.js", "content/zoom.js"],
      "run_at": "document_idle"
    }
  ]
}
